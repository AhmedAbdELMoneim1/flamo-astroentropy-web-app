# Frontend: build with Node, serve with Caddy (automatic HTTPS when a domain is set).
FROM node:22-slim AS build
WORKDIR /f
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npx vite build

FROM caddy:2
COPY --from=build /f/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
